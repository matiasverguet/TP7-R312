---
import * as Plot from "@observablehq/plot";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import rawSharks from "../data/requins.json";

const sharkColors = ["#1769aa", "#f28e2b", "#59a14f"];
const sharkSpecies = ["Great White", "Tiger", "Shortfin Mako"];

const sharks = rawSharks.filter((shark) => shark.species);
const measuredSharks = sharks.filter(
  (shark) =>
    shark.total_length_cm !== null &&
    shark.body_mass_kg !== null &&
    shark.dorsal_fin_height_cm !== null &&
    shark.pectoral_fin_length_cm !== null,
);
const sharksWithSex = sharks.filter((shark) => shark.sex);

const color = { domain: sharkSpecies, range: sharkColors, legend: true };

const speciesOptions = {
  title: "Nombre d'observations par espèce",
  subtitle: "Les requins enregistrés dans la base de données",
  ariaLabel: "Barres du nombre d'observations par espèce de requin",
  height: 280,
  marginLeft: 125,
  x: { grid: true, label: "Observations" },
  y: { label: "Espèce" },
  color,
  marks: [
    Plot.barX(sharks, Plot.groupY({ x: "count" }, { y: "species", fill: "species" })),
    Plot.ruleX([0]),
  ],
};

const lengthOptions = {
  title: "Distribution de la longueur totale",
  subtitle: "Longueur des requins mesurés, en centimètres",
  ariaLabel: "Histogramme de la longueur totale des requins",
  height: 300,
  x: { label: "Longueur totale (cm)" },
  y: { grid: true, label: "Observations" },
  color,
  marks: [
    Plot.rectY(
      measuredSharks,
      Plot.binX({ y: "count" }, { x: "total_length_cm", fill: "species" }),
    ),
    Plot.ruleY([0]),
  ],
};

const massLengthOptions = {
  title: "Longueur et masse corporelle",
  subtitle: "Une observation par point, colorée par espèce",
  ariaLabel: "Nuage de points de la longueur et de la masse des requins",
  height: 340,
  grid: true,
  x: { label: "Longueur totale (cm)" },
  y: { label: "Masse corporelle (kg)" },
  color,
  marks: [
    Plot.dot(measuredSharks, {
      x: "total_length_cm",
      y: "body_mass_kg",
      fill: "species",
      stroke: "species",
      fillOpacity: 0.75,
      r: 5,
      tip: true,
    }),
  ],
};

const finsOptions = {
  title: "Comparaison des nageoires",
  subtitle: "Hauteur de la nageoire dorsale et longueur pectorale",
  ariaLabel: "Nuage de points des mesures des nageoires de requins",
  height: 340,
  grid: true,
  x: { label: "Nageoire pectorale (cm)" },
  y: { label: "Nageoire dorsale (cm)" },
  color,
  marks: [
    Plot.dot(measuredSharks, {
      x: "pectoral_fin_length_cm",
      y: "dorsal_fin_height_cm",
      fill: "species",
      stroke: "species",
      fillOpacity: 0.75,
      r: 5,
      tip: true,
    }),
  ],
};

const regionOptions = {
  title: "Répartition par région",
  subtitle: "Nombre de requins enregistrés selon la zone d'observation",
  ariaLabel: "Barres de la répartition des requins par région",
  height: 360,
  marginLeft: 150,
  x: { grid: true, label: "Observations" },
  y: { label: "Région" },
  color,
  marks: [
    Plot.barX(
      sharks,
      Plot.groupY({ x: "count" }, { y: "region", fill: "species", sort: { y: "-x" } }),
    ),
    Plot.ruleX([0]),
  ],
};

const sexOptions = {
  title: "Répartition des sexes",
  subtitle: "Les valeurs manquantes sont exclues",
  ariaLabel: "Barres empilées des sexes par espèce de requin",
  height: 300,
  marginLeft: 125,
  x: { grid: true, label: "Observations" },
  y: { label: "Espèce" },
  color: { legend: true },
  marks: [
    Plot.barX(
      sharksWithSex,
      Plot.groupY({ x: "count" }, { y: "species", fill: "sex" }),
    ),
    Plot.ruleX([0]),
  ],
};
---

<BaseLayout title="Requins">
  <h1>Exploration des requins</h1>
  <p class="page-intro">
    Comparez les espèces, les mensurations, les nageoires et les régions présentes dans la base de données.
  </p>

  <div class="chart-card">
    <PlotFigure options={speciesOptions} />
  </div>

  <div class="chart-card">
    <PlotFigure options={lengthOptions} />
  </div>

  <div class="chart-card">
    <PlotFigure options={massLengthOptions} />
  </div>

  <div class="chart-card">
    <PlotFigure options={finsOptions} />
  </div>

  <div class="chart-card">
    <PlotFigure options={regionOptions} />
  </div>

  <div class="chart-card">
    <PlotFigure options={sexOptions} />
  </div>
</BaseLayout>