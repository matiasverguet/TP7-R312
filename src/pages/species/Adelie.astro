---
import Layout from '../../layouts/BaseLayout.astro';
import PlotFigure from '../../components/PlotFigure.astro';
import SpeciesNav from '../../components/SpeciesNav.astro';
import * as Plot from '@observablehq/plot';
import penguins from '../../data/penguins.json';
import { speciesColorDomain, speciesColorRange } from '../../data/speciesColors';

// Filtrage demandé par la consigne
const penguinsAdelie = penguins.filter(({ species }) => species === "Adelie");
---

<Layout title="Espèce : Adélie">
  <div class="p-6">
    <SpeciesNav />
    <a href="/species" class="mb-4 inline-block text-blue-600 hover:underline">&larr; Retour aux espèces</a>
    <h1 class="text-2xl font-bold mb-4">Manchots Adélie</h1>



    <PlotFigure options={{
      color: { domain: speciesColorDomain, range: speciesColorRange },
      marks: [
        Plot.dot(penguinsAdelie, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species"
        })
      ]
    }} />
  </div>
</Layout>